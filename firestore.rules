rules_version = '2';

// =====================================================================
// 認証ベースのセキュリティルール（Phase1 認証基盤）
//
// - 投稿・アルバム・イベントの読み書きは「承認済み(approved)」ユーザーのみ。
//   更新・削除は所有者（userId / ownerId / organizerId）または管理者に限る
// - 通知は受信者本人の読み取りのみ。書き込みは Cloud Functions / Admin SDK が行う
// - users ドキュメントは本人のみ作成・更新可。ただし approved / role は
//   本人が変更できない（承認は Cloud Functions / 管理者のみ）
// - registrationApprovals / mail はクライアントから一切アクセス不可
//   （Cloud Functions / Trigger Email 拡張が Admin SDK 経由で操作する）
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isApproved() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc(request.auth.uid).approved == true;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc(request.auth.uid).role == 'admin';
    }

    // ユーザー
    match /users/{userId} {
      allow read: if isSignedIn();

      // 新規登録: 本人のみ。未承認・一般ロールでの作成を強制する
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.approved == false
        && request.resource.data.role == 'member';

      // 本人による更新: approved / role は変更不可
      allow update: if (isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.approved == resource.data.approved
          && request.resource.data.role == resource.data.role)
        || isAdmin();

      allow delete: if isAdmin();
    }

    // 投稿
    match /posts/{postId} {
      // いいね（reactions）は投稿者以外も付けられるため、非正規化カウント
      // `likeCount` の ±1 だけは他人の投稿にも許可する。これを許さないと
      // ReactionService.toggleReaction のトランザクションが丸ごと失敗し、
      // 他人の投稿にいいねできなくなる（Issue #62）。
      // 変更できるのは likeCount 1 フィールドのみで、増減幅も ±1 に限る。
      // 表示上のいいね数は reactions サブコレクションの実数なので、仮に
      // このカウントを不正に増減されても UI の数字には影響しない。
      function isLikeCountOnlyUpdate() {
        return request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['likeCount'])
          && (request.resource.data.likeCount
                == resource.data.get('likeCount', 0) + 1
            || request.resource.data.likeCount
                == resource.data.get('likeCount', 0) - 1);
      }

      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isApproved()
        && (resource.data.userId == request.auth.uid
          || isAdmin()
          || isLikeCountOnlyUpdate());
      allow delete: if isApproved()
        && (resource.data.userId == request.auth.uid || isAdmin());

      // コメント
      match /comments/{commentId} {
        allow read: if isApproved();
        allow create: if isApproved()
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isApproved()
          && (resource.data.userId == request.auth.uid || isAdmin());
      }

      // リアクション（1ユーザー1ドキュメント）
      match /reactions/{reactionUserId} {
        allow read: if isApproved();
        allow write: if isApproved() && request.auth.uid == reactionUserId;
      }
    }

    // アルバム（§3.6）
    match /albums/{albumId} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isApproved()
        && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // イベント（§3.7）
    match /events/{eventId} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.organizerId == request.auth.uid;
      allow update, delete: if isApproved()
        && (resource.data.organizerId == request.auth.uid || isAdmin());

      // 参加表明（1ユーザー1ドキュメント・§3.8）
      match /participants/{participantId} {
        allow read: if isApproved();
        allow write: if isApproved() && request.auth.uid == participantId;
      }
    }

    // 通知（§3.9）: 受信者本人の読み取りのみ。
    // 作成・更新・削除は Functions / Admin SDK が行うためクライアントには許可しない
    match /notifications/{notificationId} {
      allow read: if isApproved()
        && resource.data.recipientId == request.auth.uid;
      allow write: if false;
    }

    // 承認トークン: クライアントからは一切アクセス不可（Functions のみ）
    match /registrationApprovals/{userId} {
      allow read, write: if false;
    }

    // 送信メールキュー: クライアントからは一切アクセス不可（拡張/Functions のみ）
    match /mail/{mailId} {
      allow read, write: if false;
    }
  }
}
