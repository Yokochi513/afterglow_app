rules_version = '2';

// =====================================================================
// 認証ベースのセキュリティルール（Phase1 認証基盤）
//
// - 投稿・アルバム・イベントの読み書きは「承認済み(approved)」ユーザーのみ。
//   更新・削除は所有者（userId / ownerId / organizerId）または管理者に限る
// - 通知は受信者本人の読み取りのみ。書き込みは Cloud Functions / Admin SDK が行う
// - users ドキュメントは本人のみ作成・更新可。ただし approved / role は
//   本人が変更できない（承認は Cloud Functions / 管理者のみ）
// - registrationApprovals / mail はクライアントから一切アクセス不可
//   （Cloud Functions / Trigger Email 拡張が Admin SDK 経由で操作する）
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isApproved() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc(request.auth.uid).approved == true;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc(request.auth.uid).role == 'admin';
    }

    function contestPath(contestId) {
      return /databases/$(database)/documents/contests/$(contestId);
    }

    function postPath(postId) {
      return /databases/$(database)/documents/posts/$(postId);
    }

    function postAuthorPath(postId) {
      return /databases/$(database)/documents/posts/$(postId)/private/author;
    }

    function isContestEntryOpen(contestId) {
      return exists(contestPath(contestId))
        && request.time < get(contestPath(contestId)).data.entryDeadline;
    }

    function isContestVotingOpen(contestId) {
      return exists(contestPath(contestId))
        && get(contestPath(contestId)).data.entryDeadline <= request.time
        && request.time < get(contestPath(contestId)).data.votingDeadline;
    }

    function isContestPost(postData) {
      return postData.get('contestId', null) is string;
    }

    function isPostAuthor(postId, uid) {
      return exists(postPath(postId))
        && (
          get(postPath(postId)).data.get('userId', '') == uid
          || (
            get(postPath(postId)).data.get('userId', '') == ''
            && exists(postAuthorPath(postId))
            && get(postAuthorPath(postId)).data.userId == uid
          )
        );
    }

    // ユーザー
    match /users/{userId} {
      allow read: if isSignedIn();

      // 新規登録: 本人のみ。未承認・一般ロールでの作成を強制する
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.approved == false
        && request.resource.data.role == 'member';

      // 本人による更新: approved / role は変更不可
      allow update: if (isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.approved == resource.data.approved
          && request.resource.data.role == resource.data.role)
        || isAdmin();

      allow delete: if isAdmin();

      // メールアドレス等の個人情報。users/{userId} 本体は投稿者名表示のため
      // 承認可否に関わらずログイン済みユーザー全員に公開されるので、
      // ここに分離して本人のみ読み書きできるようにする
      match /private/{document=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // 投稿
    match /posts/{postId} {
      // いいね（reactions）は投稿者以外も付けられるため、非正規化カウント
      // `likeCount` の ±1 だけは他人の投稿にも許可する。これを許さないと
      // ReactionService.toggleReaction のトランザクションが丸ごと失敗し、
      // 他人の投稿にいいねできなくなる（Issue #62）。
      // 変更できるのは likeCount 1 フィールドのみで、増減幅も ±1 に限る。
      // 表示上のいいね数は reactions サブコレクションの実数なので、仮に
      // このカウントを不正に増減されても UI の数字には影響しない。
      function isLikeCountOnlyUpdate() {
        return request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['likeCount'])
          && (request.resource.data.likeCount
                == resource.data.get('likeCount', 0) + 1
            || request.resource.data.likeCount
                == resource.data.get('likeCount', 0) - 1);
      }

      function isContestAuthorEditing() {
        return isContestPost(resource.data)
          && exists(postAuthorPath(postId))
          && get(postAuthorPath(postId)).data.userId == request.auth.uid
          && isContestEntryOpen(resource.data.contestId);
      }

      allow read: if isApproved();
      allow create: if isApproved()
        && (
          (
            request.resource.data.userId == request.auth.uid
            && request.resource.data.get('contestId', null) == null
          )
          || (
            request.resource.data.get('contestId', null) is string
            && request.resource.data.userId == ''
            && request.resource.data.voteCount == 0
            && isContestEntryOpen(request.resource.data.contestId)
          )
        );
      // voteCount はクライアントから直接書き換えられない。投票の実体は
      // contests/{contestId}/votes/{userId} のみで、その増減の反映は
      // Cloud Functions（Admin SDK）の onContestVoteChange が行う（下記参照）。
      // 実数を承認済みユーザー全員に見せる集計値のため、likeCount と違い
      // クライアントの直接更新を許すと得票数を不正に書き換えられてしまう。
      allow update: if isApproved()
        && (resource.data.userId == request.auth.uid
          || isAdmin()
          || isLikeCountOnlyUpdate()
          || isContestAuthorEditing());
      allow delete: if isApproved()
        && (resource.data.userId == request.auth.uid
          || isAdmin()
          || isContestAuthorEditing());

      // コンテスト投稿の実投稿者 UID。匿名期間中も本人と管理者だけが読める。
      match /private/{document=**} {
        allow read: if isAdmin()
          || (isSignedIn() && resource.data.userId == request.auth.uid);
        allow create: if isApproved()
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if false;
      }

      // コメント
      match /comments/{commentId} {
        allow read: if isApproved();
        allow create: if isApproved()
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isApproved()
          && (resource.data.userId == request.auth.uid || isAdmin());
      }

      // リアクション（1ユーザー1ドキュメント）
      match /reactions/{reactionUserId} {
        allow read: if isApproved();
        allow write: if isApproved() && request.auth.uid == reactionUserId;
      }
    }

    // コンテスト。投票内容は本人と管理者だけが読める。
    match /contests/{contestId} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if isApproved()
        && (resource.data.creatorId == request.auth.uid || isAdmin());

      match /votes/{userId} {
        allow read: if isAdmin()
          || (isSignedIn() && request.auth.uid == userId);
        allow create, update: if isApproved()
          && request.auth.uid == userId
          && request.resource.data.postId is string
          && exists(postPath(request.resource.data.postId))
          && get(postPath(request.resource.data.postId)).data.contestId == contestId
          && isContestVotingOpen(contestId)
          && !isPostAuthor(request.resource.data.postId, request.auth.uid);
        allow delete: if isApproved()
          && request.auth.uid == userId
          && isContestVotingOpen(contestId);
      }
    }

    // アルバム（§3.6）
    match /albums/{albumId} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isApproved()
        && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // イベント（§3.7）
    match /events/{eventId} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.organizerId == request.auth.uid;
      allow update, delete: if isApproved()
        && (resource.data.organizerId == request.auth.uid || isAdmin());

      // 参加表明（1ユーザー1ドキュメント・§3.8）
      match /participants/{participantId} {
        allow read: if isApproved();
        allow write: if isApproved() && request.auth.uid == participantId;
      }
    }

    // 通知（§3.9）: 受信者本人の読み取りのみ。
    // 作成・更新・削除は Functions / Admin SDK が行うためクライアントには許可しない
    match /notifications/{notificationId} {
      allow read: if isApproved()
        && resource.data.recipientId == request.auth.uid;
      allow write: if false;
    }

    // 承認トークン: クライアントからは一切アクセス不可（Functions のみ）
    match /registrationApprovals/{userId} {
      allow read, write: if false;
    }

    // 送信メールキュー: クライアントからは一切アクセス不可（拡張/Functions のみ）
    match /mail/{mailId} {
      allow read, write: if false;
    }
  }
}
